PORT=3001
DB_PATH=./database/toolbox.db

# Read exactly once, the first time the app boots with no local user in the
# database yet: it's hashed with bcrypt and stored as the local admin account
# (see backend/services/userService.js:ensureLocalAdminUser). After that
# first migration, this value is never read again - change the password via
# Admin Center instead. Safe to remove this line entirely once migrated.
ADMIN_PASSWORD=pickAStrongPassword

# Backups (daily automatic backup + manual restore endpoint). Relative paths
# resolve against backend/, so the defaults below match backend/database/backups
# and backend/temp exactly as before this file existed.
BACKUP_DIR=./database/backups
TEMP_DIR=./temp

# Admin-uploaded logo/favicon/login-background (Admin Center's Branding tab).
# Served publicly at /uploads/branding/<file> - see app.js. Relative path
# resolves against backend/, matching backend/database/uploads/branding.
# BRANDING_UPLOADS_DIR=./database/uploads/branding

# Restore audit log (backend/routes/backup.js). Relative path resolves
# against backend/, matching backend/logs exactly as before this line existed.
LOG_DIR=./logs

# Comma-separated list of extra origins allowed to call the API from a browser.
# Same-origin calls are always allowed, so this is only needed for a frontend
# served from a different origin than the API (e.g. the Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 when a reverse proxy sits in front, so the rate limiter sees the
# real client IP instead of the proxy's.
# TRUST_PROXY=1

# Where the Entra ID (Microsoft SSO) callback sends the browser back to once
# sign-in finishes - the callback itself lands on this API's own origin
# (Microsoft redirects straight to it), so it needs to know explicitly where
# the frontend lives. Defaults to the first entry in ALLOWED_ORIGINS if unset.
# Irrelevant unless Authentication mode is set to Entra ID or Hybrid.
# FRONTEND_URL=http://localhost:5173

# 64 hex characters (32 bytes) - encrypts the Entra ID Client Secret at rest
# in the database. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required only to enable Entra ID or Hybrid authentication mode; local
# password authentication never needs this. Losing/changing this key makes
# any previously-saved Client Secret unreadable - just re-enter it in Admin
# Center afterward.
# AUTH_ENCRYPTION_KEY=
